import nltk
from nltk import CFG

grammar = CFG.fromstring("""
S -> NP VP
NP -> Det N
VP -> V NP
Det -> 'the'
N -> 'boy' | 'ball'
V -> 'kicks'
""")

parser = nltk.ChartParser(grammar)
sentence = "the boy kicks the ball".split()

for tree in parser.parse(sentence):
    print(tree)
    tree.pretty_print()
